{
  "tokenizer": {
    "type": "BPE",
    "min_frequency": 3
  },
  "model": {
    "model_type": "Decoder Transformer",
    "model_name": "Peak",
    "vocab_size": 8192,
    "ctx_length": 256,
    "d_model": 256,
    "n_layers": 6,
    "n_heads": 8,
    "n_kv_heads": 2,
    "d_ff": 512
  },
  "training": {
    "batch_size": 64,
    "gradient_accumulation_steps": 2,
    "learning_rate": 0.0003,
    "min_learning_rate" : 0.00002,
    "weight_decay": 0.1,
    "max_grad_norm": 1.0,
    "epochs": 4,
    "warmup_ratio": 0.03,
    "dropout": 0.05
  },
  "inference":
  {
    "max_tokens" : 70,
    "temperature" : 0.4,
    "top_k" : 20,
    "top_p":   0.85,
    "repetition_penalty" : 1.18,
    "sampling_method" :  "softmax"
  },
  "data": {
    "dataset" : ["SimpleStories","TinyStories"],
    "total" : 275000
  }
}